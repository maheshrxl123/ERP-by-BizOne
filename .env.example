# BizOne ERP Environment Configuration
# Only VITE_* variables are exposed to the browser. Never place secrets in VITE_* variables.

# Required: Public Supabase project endpoint & publishable/anon key (protected by RLS)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_APP_NAME="BizOne ERP"

# Server-only trusted secrets (never exposed to browser code)
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
APP_ENCRYPTION_KEY="MY_32_BYTE_HEX_ENCRYPTION_KEY"

# Optional server/CLI provisioning variables
SUPABASE_ACCESS_TOKEN="MY_SUPABASE_ACCESS_TOKEN"
SUPABASE_PROJECT_REF="YOUR_PROJECT_REF"
